# Copy to apps/client/.env.local before starting the client:
#   cp apps/client/.env.example apps/client/.env.local

# Base URL of the NestJS API, including the /api/v1 global prefix.
# Without this the client falls back to the same default and talks to the API
# on port 3001 — change it only if SERVER_PORT in apps/server/.env differs.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
