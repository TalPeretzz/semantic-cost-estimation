# Copy to apps/server/.env before starting the API:
#   cp .env.example apps/server/.env

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml. Port 5434 (not 5432) so the
# container does not collide with a PostgreSQL already running on the host.
POSTGRES_USER=sce
POSTGRES_PASSWORD=sce_secret
POSTGRES_DB=sce_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Anthropic — required ────────────────────────────────────────────────────
# Claude extracts the semantic signals. The server will not start without it.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI — required ───────────────────────────────────────────────────────
# gpt-4o-mini re-rates the same signals as an independent cross-model check.
# Also required at startup: GptValidationService resolves it in its constructor.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── pgAdmin (optional) ──────────────────────────────────────────────────────
# Only needed if you start the pgadmin service: docker compose up -d pgadmin
PGADMIN_EMAIL=admin@sce.local
PGADMIN_PASSWORD=admin
